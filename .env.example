# ==========================================
# ECOBAZAR Environment Configuration
# ==========================================

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# API Server
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# Security & Tokens
JWT_ACCESS_SECRET=ecobazar-dev-access-super-secret-key-change-in-prod-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=ecobazar-dev-refresh-super-secret-key-change-in-prod-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecobazar_dev?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Localization & Business Defaults
DEFAULT_CURRENCY=BDT
DEFAULT_CURRENCY_SYMBOL=৳
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_LANGUAGE=en

# AI Integrations (Backend Proxy)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Bangladesh Payment Gateways (Sandbox/Staging)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2.0

NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# SMS Providers (Bangladesh)
SMS_PROVIDER=greenweb
SMS_API_KEY=
SMS_SENDER_ID=
